{
  "name": "typerush",
  "version": "1.2.0",
  "description": "Interactive terminal-based typing speed application",
  "main": "dist/index.js",
  "bin": {
    "typerush": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "server": "ts-node src/server.ts",
    "server:prod": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "typing",
    "speed",
    "terminal",
    "cli",
    "typing-test",
    "typing-game",
    "wpm",
    "typing-speed"
  ],
  "author": "Manoj Uppala <manojuppala@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojuppala/typerush.git"
  },
  "bugs": {
    "url": "https://github.com/manojuppala/typerush/issues"
  },
  "homepage": "https://github.com/manojuppala/typerush#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
